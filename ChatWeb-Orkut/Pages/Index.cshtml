@page
@model IndexModel

@{
    ViewData["Title"] = "Entrar";
}

<link rel="stylesheet" href="~/css/login.css" />

<div class="pagina-login">

    <div class="login-container">

        <section class="login-apresentacao">

            <h1>
                conecte-se com seus amigos
            </h1>

            <p>
                Um espaço simples para conversar,
                trocar mensagens e ficar conectado.
            </p>

            <div class="login-destaques">
                <span>💗 pessoas</span>
                <span>💬 conversas</span>
                <span>🌐 online</span>
            </div>
        </section>


        <section class="login-card">

            <h2>Bem-vindo(a)!</h2>

            <p>
                Digite seu nome para entrar no chat.
            </p>

            <label for="nomeUsuario">
                Nome de usuário
            </label>

            <input type="text"
                   id="nomeUsuario"
                   placeholder="Digite seu nome"
                   autocomplete="off" />

            <button type="button"
                    id="btnEntrar">
                Entrar
            </button>

        </section>

    </div>

</div>


<script>
    const btnEntrar =
        document.getElementById("btnEntrar");

    const nomeUsuario =
        document.getElementById("nomeUsuario");

    btnEntrar.addEventListener(
        "click",
        entrarNoChat
    );

    nomeUsuario.addEventListener(
        "keydown",
        function (event) {

            if (event.key === "Enter") {
                entrarNoChat();
            }
        }
    );

    function entrarNoChat() {

        const nome =
            nomeUsuario.value.trim();

        if (nome === "") {

            alert("Digite seu nome.");

            return;
        }

        window.location.href =
            "/Chat?nome=" +
            encodeURIComponent(nome);
    }
</script>