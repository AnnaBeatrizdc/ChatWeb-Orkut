@page
@model IndexModel
@{
    ViewData["Title"] = "Entrar";
}

<div class="login-pagina">

    <div class="login-caixa">

        <div class="login-logo">
            <h1>Chat Web</h1>
            <p>Conecte-se com seus amigos 💬</p>
        </div>

        <div class="login-formulario">

            <label for="nomeUsuario">
                Nome de usuário
            </label>

            <input type="text"
                   id="nomeUsuario"
                   placeholder="Digite seu nome"
                   autocomplete="off" />

            <button type="button"
                    id="btnEntrar">
                Entrar
            </button>

        </div>

    </div>

</div>

<script>
    const btnEntrar = document.getElementById("btnEntrar");
    const nomeUsuario = document.getElementById("nomeUsuario");

    btnEntrar.addEventListener("click", entrarNoChat);

    nomeUsuario.addEventListener("keydown", function(event) {
        if (event.key === "Enter") {
            entrarNoChat();
        }
    });

    function entrarNoChat() {

        const nome = nomeUsuario.value.trim();

        if (nome === "") {
            alert("Digite seu nome.");
            return;
        }

        window.location.href =
            "/Chat?nome=" + encodeURIComponent(nome);
    }
</script>