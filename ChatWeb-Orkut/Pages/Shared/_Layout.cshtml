<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChatWeb_Orkut</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ChatWeb_Orkut.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="topo-site">
        <div class="topo-conteudo">

            <a class="logo-site" asp-page="/Index">
                Orkut 2.0
            </a>

            <nav class="menu-site">
                <a asp-page="/Index">Login</a>
            </nav>

        </div>
    </header>
    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="rodape-site">
        <div class="rodape-conteudo">
            <p>
                Desenvolvido para fins acadêmicos por
                <strong>Anna Beatriz e Eduardo Paiva</strong> 
                <span>© 2026 Orkut 2.0</span>
            </p>

            
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
